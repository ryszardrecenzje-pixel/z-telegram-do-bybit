# === Telegram (Telethon userbot) ===
# Get api_id and api_hash from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
# Phone number in international format, e.g. +48123456789
TELEGRAM_PHONE=+48XXXXXXXXX
# Username of the signal bot (without @), e.g. TraderRicziV2
SIGNAL_BOT_USERNAME=TraderRicziV2

# === Binance (optional – for later live / testnet) ===
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# === Risk settings (defaults, can be changed in Streamlit) ===
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
DEFAULT_POSITION_SIZE_USD=100