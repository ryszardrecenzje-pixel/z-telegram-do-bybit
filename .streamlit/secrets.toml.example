# ============================================================
# Skopiuj ten plik jako secrets.toml  LUB  wklej wartości
# w panelu Streamlit Cloud → Settings → Secrets
# ============================================================
#
# WAŻNE: Streamlit secrets używa formatu TOML.
# Możesz użyć zagnieżdżonego (zalecane) albo płaskiego formatu.
#
# --- Wariant A (zalecany – zagnieżdżony) ---

[telegram]
api_id = 31647829
api_hash = "WSTAW_SWOJ_API_HASH"
phone = "+48514934698"
signal_bot_username = "TraderRicziV2"

[binance]
api_key = "WSTAW_SWOJ_BINANCE_API_KEY"
api_secret = "WSTAW_SWOJ_BINANCE_SECRET"
testnet = true

[risk]
position_size_pct = 10.0
sl_pct = 1.0
tp_pct = 3.0
max_daily_loss_pct = 3.0
invert_signal = true

# --- Wariant B (płaski – też działa) ---
# TELEGRAM_API_ID = 31647829
